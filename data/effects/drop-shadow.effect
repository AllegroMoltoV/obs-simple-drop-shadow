// Drop Shadow Effect for OBS Studio
// Simple drop shadow with offset, blur, color, and opacity

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d blurred_image;

uniform float2 shadow_offset;
uniform float blur_radius;
uniform float4 shadow_color;
uniform float shadow_opacity;
uniform float2 texel_size;

sampler_state defaultSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertInOut {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut v_in)
{
    VertInOut v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 PSHorizontal(VertInOut v_in) : TARGET
{
    int radius = (int)ceil(blur_radius);
    float alpha = 0.0;
    float2 shadow_uv = v_in.uv - float2(shadow_offset.x * texel_size.x, 0.0);

    for (int x = -radius; x <= radius; x++) {
        float2 offset = float2((float)x * texel_size.x, 0.0);
        alpha += image.Sample(defaultSampler, shadow_uv + offset).a;
    }

    return float4(0.0, 0.0, 0.0, alpha / (float)(2 * radius + 1));
}

float4 CompositeShadow(float4 original, float shadow_alpha)
{
    float4 shadow = float4(shadow_color.rgb, shadow_alpha * shadow_opacity * shadow_color.a);
    float4 result;
    result.rgb = original.rgb * original.a + shadow.rgb * shadow.a * (1.0 - original.a);
    result.a = original.a + shadow.a * (1.0 - original.a);
    if (result.a > 0.0) {
        result.rgb /= result.a;
    }
    result.rgb *= result.a;
    return result;
}

float4 PSVerticalComposite(VertInOut v_in) : TARGET
{
    float4 original = image.Sample(defaultSampler, v_in.uv);
    float2 shadow_uv = v_in.uv - float2(0.0, shadow_offset.y * texel_size.y);
    int radius = (int)ceil(blur_radius);
    float shadow_alpha = 0.0;

    for (int y = -radius; y <= radius; y++) {
        float2 offset = float2(0.0, (float)y * texel_size.y);
        shadow_alpha += blurred_image.Sample(defaultSampler, shadow_uv + offset).a;
    }
    shadow_alpha /= (float)(2 * radius + 1);

    return CompositeShadow(original, shadow_alpha);
}

technique Horizontal
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSHorizontal(v_in);
    }
}

technique VerticalComposite
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSVerticalComposite(v_in);
    }
}
