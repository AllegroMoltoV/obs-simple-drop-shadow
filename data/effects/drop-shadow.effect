// Drop Shadow Effect for OBS Studio
// 影のマスクを作り、Dual Kawase (縮小と拡大の繰り返し) か分離型ガウシアンでぼかし、元画像と合成する。
// 座標はすべて出力 (キャンバス) の画素で扱い、元画像はキャンバスの canvas_origin に置く。

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d mask_image;

// Mask / Composite で使う。キャンバス上の元画像と影の位置
uniform float2 canvas_size;
uniform float2 source_size;
uniform float2 canvas_origin;
uniform float2 shadow_origin;

// Down / Up / Gauss で使う。Down は出力、Up と Gauss は入力のテクスチャの 1 画素の UV 幅
uniform float2 texel_size;
uniform float gauss_sigma;
uniform int gauss_taps;

uniform float4 shadow_color;
uniform float shadow_opacity;

sampler_state linearClamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertInOut {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut v_in)
{
    VertInOut v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// 元画像の外側を透明として読む。境界の 1 画素は線形補間と同じ割合で薄める
float4 SampleSource(float2 canvas_px, float2 origin)
{
    float2 px = canvas_px - origin;
    float2 coverage = saturate(px + 0.5) * saturate(source_size - px + 0.5);
    float4 color = image.Sample(linearClamp, px / source_size);
    return color * (coverage.x * coverage.y);
}

float4 PSMask(VertInOut v_in) : TARGET
{
    float a = SampleSource(v_in.uv * canvas_size, shadow_origin).a;
    return float4(a, a, a, a);
}

// Bjørge (SIGGRAPH 2015) の縮小フィルター。中心 4 倍と斜め 4 点の合計 8 で割る
float4 PSDown(VertInOut v_in) : TARGET
{
    float2 hp = texel_size * 0.5;
    float sum = mask_image.Sample(linearClamp, v_in.uv).r * 4.0;
    sum += mask_image.Sample(linearClamp, v_in.uv - hp).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + hp).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(hp.x, -hp.y)).r;
    sum += mask_image.Sample(linearClamp, v_in.uv - float2(hp.x, -hp.y)).r;
    float a = sum / 8.0;
    return float4(a, a, a, a);
}

// Bjørge (SIGGRAPH 2015) の拡大フィルター。8 点を重み 1 と 2 で合計 12 で割る
float4 PSUp(VertInOut v_in) : TARGET
{
    float2 hp = texel_size * 0.5;
    float sum = mask_image.Sample(linearClamp, v_in.uv + float2(-hp.x * 2.0, 0.0)).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(-hp.x, hp.y)).r * 2.0;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(0.0, hp.y * 2.0)).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(hp.x, hp.y)).r * 2.0;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(hp.x * 2.0, 0.0)).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(hp.x, -hp.y)).r * 2.0;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(0.0, -hp.y * 2.0)).r;
    sum += mask_image.Sample(linearClamp, v_in.uv + float2(-hp.x, -hp.y)).r * 2.0;
    float a = sum / 12.0;
    return float4(a, a, a, a);
}

// 分離型ガウシアン。texel_size の片方を 0 にして方向を決める。
// GLSL は C 形式のキャストを許さないため、型変換はコンストラクタ形式で書く
float4 PSGauss(VertInOut v_in) : TARGET
{
    float sum = mask_image.Sample(linearClamp, v_in.uv).r;
    float weight_sum = 1.0;
    float inv = 1.0 / (2.0 * gauss_sigma * gauss_sigma);
    for (int i = 1; i <= gauss_taps; i++) {
        float d = float(i);
        float w = exp(-d * d * inv);
        float2 offset = texel_size * d;
        sum += (mask_image.Sample(linearClamp, v_in.uv + offset).r +
                mask_image.Sample(linearClamp, v_in.uv - offset).r) * w;
        weight_sum += 2.0 * w;
    }
    float a = sum / weight_sum;
    return float4(a, a, a, a);
}

float4 PSComposite(VertInOut v_in) : TARGET
{
    float4 original = SampleSource(v_in.uv * canvas_size, canvas_origin);
    float shadow_alpha = mask_image.Sample(linearClamp, v_in.uv).r * shadow_opacity * shadow_color.a;
    float3 rgb = original.rgb * original.a + shadow_color.rgb * shadow_alpha * (1.0 - original.a);
    float a = original.a + shadow_alpha * (1.0 - original.a);
    return float4(rgb, a);
}

technique Mask
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSMask(v_in);
    }
}

technique Down
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDown(v_in);
    }
}

technique Up
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSUp(v_in);
    }
}

technique Gauss
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSGauss(v_in);
    }
}

technique Composite
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSComposite(v_in);
    }
}
